# Backend base URL (Express). Dev default already falls back to this.
VITE_API_URL="http://localhost:4000"
# Dev-only SEB raw key so a plain browser can mint SEB headers for the student
# runner (header = sha256 hex of `<api-base><path><raw>`). Must match an ACTIVE
# seb_key row (see backend seedTestData SEB_DEV_RAW). NEVER set in production —
# real Safe Exam Browser sends the header itself; unset shows the SEB banner.
# VITE_SEB_DEV_KEY="dev-frontend-lab-key-please-rotate"
