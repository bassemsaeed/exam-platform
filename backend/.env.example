# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/exam_platform"
BETTER_AUTH_SECRET="change-me-to-32-plus-random-chars-minimum-length"
BETTER_AUTH_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:5173"
PORT="4000"
# pg pool per app process. Keep small; scale servers + PgBouncer, not max.
POOL_MAX="20"
POOL_IDLE_MS="10000"
POOL_CONNECT_MS="5000"
POOL_STATEMENT_MS="30000"
# Auth session lifetime (hours) + login rate limit.
SESSION_HOURS="12"
RATE_AUTH_MAX="60"
RATE_AUTH_WINDOW_MS="60000"
BODY_LIMIT="2mb"
# Pagination + upload caps.
PAGE_DEFAULT="20"
PAGE_MAX="100"
UPLOAD_MAX_MB="10"
# Excel import: batch lifetime + password-hash parallelism.
IMPORT_TTL_MIN="30"
IMPORT_HASH_CONCURRENCY="25"
PASSWORD_MIN="8"
# Heartbeat considered stale after this (monitoring only, never submits).
HEARTBEAT_STALE_MS="90000"
# Student runner rate limits and timeouts.
RATE_STUDENT_START_MAX="30"
RATE_STUDENT_START_WINDOW_MS="60000"
RATE_STUDENT_SUBMIT_MAX="30"
RATE_STUDENT_SUBMIT_WINDOW_MS="60000"
IDEMPOTENCY_TTL_MS="300000"
SSE_KEEP_ALIVE_MS="15000"
# Max SSE replay rows per connect (latest N; started/submitted telemetry
# excluded from student streams).
SSE_REPLAY_MAX="200"
# Heartbeat/flag flood caps (per user).
RATE_STUDENT_HEARTBEAT_MAX="10"
RATE_STUDENT_HEARTBEAT_WINDOW_MS="60000"
RATE_STUDENT_FLAG_MAX="30"
RATE_STUDENT_FLAG_WINDOW_MS="60000"
# Answer save flood cap (per user): fast typing stays under, scripts don't.
RATE_STUDENT_ANSWER_MAX="120"
RATE_STUDENT_ANSWER_WINDOW_MS="60000"
# Max items per PATCH .../answers batch (exam-sized; blocks oversized tx).
ANSWERS_BATCH_MAX="200"
# Zip bomb caps: entries, per-file and total decompressed bytes.
ZIP_MAX_FILES="200"
ZIP_MAX_FILE_MB="5"
ZIP_MAX_TOTAL_MB="50"
# Expiry sweeper: poll interval + auto-submits per tick.
SWEEP_POLL_MS="30000"
SWEEP_BATCH_MAX="100"
# Export worker: poll interval, cursor page size, sync-download row cap.
EXPORT_POLL_MS="5000"
EXPORT_PAGE_SIZE="500"
EXPORT_SYNC_MAX_ROWS="2000"
# SEB header name + minimum raw key length.
SEB_HEADER="X-SafeExamBrowser-RequestHash"
SEB_MIN_KEY_LENGTH="16"
# Placeholder email domain for username-only Excel rows.
EMAIL_PLACEHOLDER_DOMAIN="uni.local"
# Local-disk uploads (single-server dev only; S3/MinIO for shared setups).
UPLOAD_DIR=""
# S3-compatible storage (MinIO). Empty S3_ENDPOINT = local disk driver.
S3_ENDPOINT=""
S3_BUCKET="exam-platform"
S3_REGION="us-east-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_PUBLIC_URL=""
# List caps.
LIST_MEMBERS_MAX="500"
LIST_COMPENSATE_MAX="5000"
LIST_EXPORTS_MAX="50"
LIST_RESULTS_MAX="1000"
# Seed term (one-shot; change before first seed for a new year).
SEED_TERM_NAME="Fall-2026"
SEED_TERM_START="2026-09-01"
SEED_TERM_END="2026-12-31"
# Seed safety: seed:test (fixed demo passwords, published SEB dev key) and
# seed:exams (wipes the current term's exams) refuse to run with
# NODE_ENV=production unless the matching flag is "true". Dev/test run free.
ALLOW_SEED_TEST_DATA=""
ALLOW_DESTRUCTIVE_SEED=""
# Comma-separated SEB Browser Exam Keys (one per lab). Hashes stored in seb_key table;
# raw keys ALSO sealed into seb_key.encrypted_key (AES-256-GCM) so API-registered
# labs verify without re-entering keys in env.
SEB_BOOTSTRAP_KEYS=""
# AES-256-GCM key for SEB raws at rest (32 bytes hex). REQUIRED at boot for
# register/rotate/verify paths that touch encryptedKey.
ENCRYPTION_KEY=""
# Trusted proxy hops for req.protocol/host (SEB hash + req.ip). 1 = one LB.
TRUST_PROXY="1"
# ...but X-Forwarded-For is ONLY honored from these peers (names/IPs/CIDRs).
# Rotating the header from anywhere else cannot rotate rate-limit buckets.
# Production: set to the load balancer IPs. Empty = fall back to TRUST_PROXY.
TRUSTED_PROXY_IPS=""
# Same discipline, CIDR syntax, for Better Auth's internal limiter.
AUTH_TRUSTED_PROXY_CIDRS="127.0.0.1/32,::1/128"
# Redis for cluster-wide rate limits + SSE fan-out (multi-server only).
# Empty = in-process stores (single-server dev). Set to e.g. redis://redis:6379
# alongside PgBouncer + S3 before a 5k exam day.
REDIS_URL=""
