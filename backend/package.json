{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "seed": "tsx --env-file=.env src/seed.ts",
    "seed:test": "tsx --env-file=.env src/seedTestData.ts",
    "seed:exams": "tsx --env-file=.env src/seedExams.ts",
    "auth:generate": "pnpm dlx auth@latest generate --output prisma/schema.better-auth.prisma",
    "test:exam-experience": "node --env-file=.env scripts/verify-exam-experience.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "5.2.1",
    "ioredis": "^5.4.1",
    "multer": "^2.4.0",
    "pg": "^8.18.0",
    "unzipper": "^0.12.5",
    "xlsx": "^0.18.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "26.6.3",
    "@types/pg": "^8.16.0",
    "auth": "1.7.7",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "~5.9.3"
  },
  "packageManager": "pnpm@12.8.1"
}
